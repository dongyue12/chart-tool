!charts/.seed.json
charts/.history/
charts/.samples/

# —— 旧版存档（本地留着看，不进仓库）——
archive/

# —— 个人环境：技能保留，WorkBuddy 记忆不提交 ——
.workbuddy/memory/

# —— 编辑器 / 系统 ——
